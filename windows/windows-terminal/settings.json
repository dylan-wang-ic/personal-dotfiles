{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            {
                "action": "sendInput",
                "input": "\u001b[13;2u"
            },
            "id": "User.sendInput.ShiftEnter"
        },
        {
            "command": "closeTab",
            "id": "User.closeTab"
        }
    ],
    "compatibility.enableUnfocusedAcrylic": false,
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "disabledProfileSources": 
    [
        "Windows.Terminal.Azure"
    ],
    "firstWindowPreference": "persistedWindowLayout",
    "initialCols": 160,
    "initialRows": 120,
    "keybindings": 
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        },
        {
            "id": "User.sendInput.ShiftEnter",
            "keys": "shift+enter"
        },
        {
            "id": null,
            "keys": "alt+left"
        },
        {
            "id": null,
            "keys": "alt+right"
        },
        {
            "id": null,
            "keys": "alt+up"
        },
        {
            "id": null,
            "keys": "alt+down"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "ctrl+alt+left"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "ctrl+alt+right"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "ctrl+alt+up"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "ctrl+alt+down"
        },
        {
            "id": "Terminal.SplitPaneLeft",
            "keys": "ctrl+alt+shift+left"
        },
        {
            "id": "Terminal.SplitPaneRight",
            "keys": "ctrl+alt+shift+right"
        },
        {
            "id": "Terminal.SplitPaneUp",
            "keys": "ctrl+alt+shift+up"
        },
        {
            "id": "Terminal.SplitPaneDown",
            "keys": "ctrl+alt+shift+down"
        },
        {
            "id": "Terminal.ClosePane",
            "keys": "ctrl+alt+w"
        },
        {
            "id": "User.closeTab",
            "keys": "ctrl+shift+w"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "ctrl+shift+left"
        },
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+shift+right"
        }
    ],
    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": 
    {
        "defaults": 
        {
            "bellStyle": "none",
            "colorScheme": "Ottosson",
            "font": 
            {
                "face": "NotoMono Nerd Font"
            },
            "historySize": 30000,
            "startingDirectory": "%USERPROFILE%\\Documents\\Workspace"
        },
        "list": 
        [
            {
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "hidden": false,
                "name": "Command Prompt"
            },
            {
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "hidden": false,
                "name": "PowerShell",
                "source": "Windows.Terminal.PowershellCore"
            },
            {
                "guid": "{83cade84-fd2b-54d0-b9f3-9a6091e0bf4f}",
                "hidden": false,
                "name": "Ubuntu",
                "source": "Microsoft.WSL"
            },
            {
                "guid": "{2ece5bfe-50ed-5f3a-ab87-5cd4baafed2b}",
                "hidden": false,
                "name": "Git Bash",
                "source": "Git"
            },
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": true,
                "name": "Windows PowerShell"
            }
        ]
    },
    "schemes": [],
    "tabWidthMode": "equal",
    "themes": [],
    "trimBlockSelection": true,
    "useAcrylicInTabRow": true
}