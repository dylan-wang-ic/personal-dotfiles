# Inherit Git for Windows defaults (UTF-8, Ctrl+Left/Right, Home/End/Delete)
$include /etc/inputrc

# Mute audible/visual terminal bell
set bell-style none

# Case-insensitive completion (also treats '-' and '_' equivalently)
set completion-ignore-case on
set completion-map-case on

# Colored completion candidates and matched prefix (uses LS_COLORS)
set colored-stats on
set colored-completion-prefix on
set mark-directories on
set mark-symlinked-directories on
set skip-completed-text on

# Show candidate list on first Tab; cycle candidates on subsequent Tab / Shift+Tab
set show-all-if-ambiguous on
set show-all-if-unmodified on
set menu-complete-display-prefix on

$if mode=emacs
  # Up/Down arrows filter history by already-typed prefix
  "\e[A": history-search-backward
  "\e[B": history-search-forward
  "\eOA": history-search-backward
  "\eOB": history-search-forward

  # Tab / Shift+Tab menu cycling (first Tab expands common prefix + lists matches)
  TAB: menu-complete
  "\e[Z": menu-complete-backward

  # Ctrl = line, Alt = word (matches PowerShell in Windows Terminal)
  "\e[1;5D": beginning-of-line   # Ctrl+Left
  "\e[1;5C": end-of-line         # Ctrl+Right
  "\e[1;3D": backward-word       # Alt+Left
  "\e[1;3C": forward-word        # Alt+Right
  "\C-h": kill-whole-line        # Ctrl+Backspace (terminals that send BS)
  "\e[127;5u": backward-kill-line # Ctrl+Backspace (Ghostty sends CSI-u)
  "\e\d": backward-kill-word     # Alt+Backspace
  "\e[3;5~": kill-line           # Ctrl+Delete
  "\e[3;3~": kill-word           # Alt+Delete
  "\C-z": undo                   # Ctrl+Z
$endif
